<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="20.01" TargetName="BRG_ToBridge" TargetType="DataType" ContainsContext="true" ExportDate="Wed Oct 21 18:01:44 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="ScanBridge">
<DataTypes Use="Context">
<DataType Use="Target" Name="BRG_ToBridge" Family="NoFamily" Class="User">
<Description>
<![CDATA[PLC/HMI -> ScanBridge. Requests execute only when ReqID changes.]]>
</Description>
<Members>
<Member Name="Heartbeat" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[PLC increments every second]]>
</Description>
</Member>
<Member Name="WriteEnable" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = bridge may write to the scanner; 0 = every command rejected (-7)]]>
</Description>
</Member>
<Member Name="ReqID" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Increment (after loading Code/Target/Tag/Value) to request a command]]>
</Description>
</Member>
<Member Name="Code" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Command code - see PLC Interface spec]]>
</Description>
</Member>
<Member Name="Target" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[-1 = frame, 0..n = Sensor slot]]>
</Description>
</Member>
<Member Name="Tag" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Command qualifier: yyy for generic write, component for slope/offset]]>
</Description>
</Member>
<Member Name="ValueR" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[REAL argument]]>
</Description>
</Member>
<Member Name="ValueI" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Integer argument]]>
</Description>
</Member>
<Member Name="Setup" DataType="BRG_SetupItem" Dimension="32" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Grade/connection setup table]]>
</Description>
</Member>
</Members>
</DataType>
</DataTypes>
</Controller>
</RSLogix5000Content>
