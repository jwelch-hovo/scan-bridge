<Description>
<![CDATA[Unix s of last completed standardize]]>
</Description>
</Member>
<Member Name="MinSinceStdz" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Minutes since last standardize]]>
</Description>
</Member>
<Member Name="ScanCount" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
