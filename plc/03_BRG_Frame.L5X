</Description>
</Member>
<Member Name="DigitalInputs" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[sp1041 (bit0 shutter open, bit2 sheet break, bit7 frame local)]]>
</Description>
</Member>
<Member Name="WorkStnCtrl" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 host in control, 1 workstation in control]]>
</Description>
</Member>
<Member Name="AEOSStatus" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 enabled]]>
</Description>
</Member>
<Member Name="AEOSError" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[sp1057]]>
</Description>
</Member>
<Member Name="SheetBreak" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sheet break indicator]]>
</Description>
</Member>
<Member Name="CalSmplStatus" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"></Member>
