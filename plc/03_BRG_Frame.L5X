<Controller Use="Context" Name="ScanBridge">
<DataTypes Use="Context">
<DataType Use="Target" Name="BRG_Frame" Family="NoFamily" Class="User">
<Description>
<![CDATA[Smart Platform frame state]]>
</Description>
<Members>
<Member Name="Mode" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 OffSheet 1 SnglPtReq 2 ScanReq 4 StdzReq 5 SinglePoint 6 Scan 7 AtEOS 8 Standardize 9 Local 10 ReadyToScan]]>
</Description>
</Member>
<Member Name="Scanning" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = Mode 6 or 7]]>
</Description>
</Member>
<Member Name="ScanTime" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Scan period s]]>
</Description>
</Member>
<Member Name="NumBoxes" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of data boxes]]>
</Description>
</Member>
<Member Name="DataBoxWidth" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Customer units]]>
</Description>
</Member>
<Member Name="HeadPos" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Last head position from TBM]]>
</Description>
</Member>
<Member Name="Direction" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[+1 forward, -1 reverse, 0 not scanning]]>
</Description>
</Member>
<Member Name="HomeEOS" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="FarEOS" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="HomeScanLimit" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="FarScanLimit" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="HomeMeasLimit" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="FarMeasLimit" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="SnglPtPos" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="OffSheetPos" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="ActiveAlarms" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
