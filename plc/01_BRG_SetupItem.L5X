<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="20.01" TargetName="BRG_SetupItem" TargetType="DataType" ContainsContext="true" ExportDate="Wed Oct 21 18:01:44 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Context" Name="ScanBridge">
<DataTypes Use="Context">
<DataType Use="Target" Name="BRG_SetupItem" Family="NoFamily" Class="User">
<Description>
<![CDATA[One grade/connection setup value written to the scanner by command 80]]>
</Description>
<Members>
<Member Name="Enable" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = send this item]]>
</Description>
</Member>
<Member Name="Target" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[-1 = frame (sp1), 0..n = Sensor slot]]>
</Description>
</Member>
<Member Name="Tag" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Device tag data identifier yyy (e.g. 3 = Offset, 2 = Slope; frame 3 = SetScanTime)]]>
</Description>
</Member>
<Member Name="Value" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Value (REAL for Single items, rounded for integer items)]]>
</Description>
</Member>
</Members>
</DataType>
</DataTypes>
</Controller>
</RSLogix5000Content>
